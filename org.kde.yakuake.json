{
    "id": "org.kde.yakuake",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.11",
    "sdk": "org.kde.Sdk",
    "command": "yakuake",
    "rename-icon": "yakuake",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.kde.kglobalaccel",
        "--talk-name=org.kde.KWin",
        "--talk-name=org.kde.plasmashell",
        "--talk-name=org.kde.StatusNotifierWatcher"
    ],
    "cleanup": [
        "/share/doc",
        "/share/qlogging-categories6"
    ],
    "modules": [
        {
            "name": "konsole",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DINSTALL_ICONS=OFF",
                "-DWITH_LIBSSH=OFF"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/konsole-26.08.3.tar.xz",
                    "sha256": "3189d1d048300fbe0628eab001b8ea11bfd6fe4fb6c0bbabc7c5aa0461dad430",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/konsole-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "kwayland",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/plasma/6.8.3/kwayland-6.8.3.tar.xz",
                    "sha256": "00090254b86f1774e296b4dc7d69d073ee08efb75419c9b5d0955eeae0378a56",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8761,
