                        "url-template": "https://download.kde.org/stable/plasma/$version/kwayland-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "yakuake",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.kde.org/stable/release-service/26.08.3/src/yakuake-26.08.3.tar.xz",
                    "sha256": "16e0ef03e8484b2841b6162509b3a0002c9bd2cdb86b9c4973e46b11c1aec44d",
                    "x-checker-data": {
                        "type": "anitya",
                        "project-id": 8763,
                        "stable-only": true,
                        "url-template": "https://download.kde.org/stable/release-service/$version/src/yakuake-$version.tar.xz"
                    }
                }
            ]
        }
    ]
